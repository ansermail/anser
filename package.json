{
  "name": "anser",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:ui && tsc -b && vite build",
    "build:preview": "npm run check:ui && tsc -b && vite build --mode preview && node scripts/check-preview.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "node scripts/desktop.mjs",
    "desktop:build": "node scripts/build-release.mjs",
    "test": "vitest run",
    "check": "tsc -b && cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:desktop": "node --test scripts/*.node-test.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "release:check": "node scripts/release-assets.mjs verify",
    "release:secrets": "node scripts/release-secrets.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \".github/workflows/*.yml\" \"package*.json\" \"src-tauri/*.json\" \"src-tauri/capabilities/*.json\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.2.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.14",
    "radix-ui": "^1.4.0",
    "react": "^19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.14.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.3.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
